# Copy to .env and edit:
#   cp .env.example .env
#
# Optional: every value below already has a working default in
# config.yaml, and running via shopassist-devops overrides all of them
# with the real container addresses anyway. Copy this file only when
# running the storefront directly on your machine (`streamlit run app.py`)
# and you need to point it somewhere else.
#
# Precedence: environment / .env  >  config.yaml  >  hardcoded default.
# See config.py for the mapping.

# Where the ShopAssist API Gateway lives. "localhost" is correct when both
# this app and the API run on your machine; inside Docker it would mean
# the container itself, which is why docker-compose.yml sets its own value.
API_BASE_URL=http://localhost:8000

# Seconds to wait for a chat reply. Must be >= the API's own
# CHAT_REQUEST_TIMEOUT_SECONDS (600 by default) - never lower. With the
# shipped CPU-only local model, one chat turn makes several sequential LLM
# calls per sub-task; a shorter value here just shows the user "AI
# Assistant is currently unavailable" while the API is still working
# normally and about to answer successfully. Measured on an 8-core
# CPU-only laptop with llama3.2:3b: ~72s for a single-agent question,
# ~318s for a two-agent one.
TIMEOUT=600

APP_TITLE=IISc Alumni Store
ENABLE_CHATBOT=true

# DEBUG also logs the raw chat request payload sent to the gateway
# (chatbot/api_client.py) - useful when debugging the API contract.
LOG_LEVEL=INFO

# Only needed if the API has API_KEY_ENFORCE=true. Must match the API's
# own API_KEY exactly, or every chat request comes back 401. Left unset
# here because the platform ships with enforcement off.
# API_KEY=
